# ============================================================================
# Local development overrides. Copy to `.env.local` (gitignored) for `npm run
# dev`. Points at the local docker-compose stack (NGINX gateway on :80).
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost

# ── Alternative: run the local UI against the deployed API ───────────────────
# localhost is deliberately NOT in the API's CORS allowlist, so the dev server
# proxies /api instead (see `rewrites` in next.config.mjs) and the browser sees
# a same-origin request. Point the public API URL at the dev server itself:
#
#   NEXT_PUBLIC_API_URL=http://localhost:3000
#   NEXT_PUBLIC_WS_URL=wss://api.fxnod.com
#   DEV_API_PROXY_TARGET=https://api.fxnod.com
#
# This talks to REAL data. Leave DEV_API_PROXY_TARGET unset unless that is what
# you actually want.
